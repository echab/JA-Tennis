{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "target": "ESNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "dom", "dom.iterable"],

    // Type checking & safety
    "strict": true,
    "types": ["vite/client", "@testing-library/jest-dom", "@types/wicg-file-system-access"],

    // "declaration": true,
    // "removeComments": true,
    // "sourceMap": true,
    // "experimentalDecorators": true,

    "outDir": "./dist"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}